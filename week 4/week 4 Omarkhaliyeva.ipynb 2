    "## Task 4: Compare learning curves\n",
    "\n",
    "A learning curve shows performance as the amount of training data increases. We will use five-fold cross-validation on the combined development data. The test set remains untouched.\n",
    "\n",
    "The helper below returns MSE, so lower values are better.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "learning-helper",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_dev = np.vstack([X_train, X_val])\n",
    "y_dev = np.concatenate([y_train, y_val])\n",
    "\n",
    "def calculate_learning_curve(degree):\n",
    "    model = make_pipeline(\n",
    "        PolynomialFeatures(degree=degree, include_bias=False),\n",
    "        StandardScaler(),\n",
    "        LinearRegression()\n",
    "    )\n",
    "    train_sizes, train_scores, val_scores = learning_curve(\n",
    "        model,\n",
    "        X_dev,\n",
    "        y_dev,\n",
    "        cv=5,\n",
    "        scoring='neg_mean_squared_error',\n",
    "        train_sizes=np.linspace(0.15, 1.0, 8),\n",
    "        shuffle=True,\n",
    "        random_state=RANDOM_STATE\n",
    "    )\n",
    "    train_mse = -train_scores.mean(axis=1)\n",
    "    val_mse = -val_scores.mean(axis=1)\n",
    "    return train_sizes, train_mse, val_mse\n"
   ]
